APP_HOST_PORT=6006
APP_ENV=development
LOG_LEVEL=INFO
WEB_CONCURRENCY=3

S3_TILES_DATA_ENDPOINT=host.docker.internal:9000
S3_TILES_DATA_BUCKET_NAME=tiles-data
S3_TILES_DATA_SECURE=false
S3_TILES_DATA_ACCESS_KEY=data_service
S3_TILES_DATA_SECRET_KEY=REPLACE_WITH_SECURE_PASSWORD

S3_BASEMAP_BUCKET_NAME=basemap-tiles
S3_WEATHER_STATIONS_BUCKET_NAME=weather-stations-data
# Dedicated bucket for hashed API key objects (keys/<sha256>.json). Mint/list/
# revoke/add-custom via /weather-stations/admin/* — the server only ever stores
# the SHA-256 hash and metadata.
S3_API_KEYS_BUCKET_NAME=api-keys

REDIS_URL=redis://redis:6379/0

# ===== SMN API (weather stations) =====
# Base URL covers both /api-token/auth (JWT mint) and /weather/station (read).
SMN_API_BASE_URL=https://api-test.smn.gob.ar/v1
SMN_API_USERNAME=REPLACE_WITH_SMN_USERNAME
SMN_API_PASSWORD=REPLACE_WITH_SMN_PASSWORD
# Optional: pause N seconds after minting a JWT before using it. Workaround
# for SMN auth-tier propagation lag. Default 0 (off). Try 1.0 if you see
# `/weather/station` 401 immediately after a successful token refresh.
SMN_API_TOKEN_SETTLING_DELAY_SECONDS=0
# Curl-style UA so SMN's WAF/bot heuristics treat us like a real client.
SMN_API_USER_AGENT=curl/8.10.1
# Diagnostic only: log every outbound SMN request (URL, headers incl. JWT,
# auth POST body incl. password). DO NOT leave on in production.
SMN_API_LOG_REQUESTS=false
# Public ZIP endpoint with the canonical EMA station registry. No auth.
SMN_STATIONS_REGISTRY_URL=http://ssl.smn.gob.ar/dpd/zipopendata.php?dato=estaciones

# ===== Weather stations admin =====
# Master password for /weather-stations/admin/* (create/list/revoke API keys).
# Required when WEATHER_STATIONS_API_KEY_AUTH_ENABLED=true (default).
WEATHER_STATIONS_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ===== Basemap provider URLs =====
# Enable/disable via settings.json (basemap_providers[].enabled).
# Only URLs live here; name/zooms/TMS/attribution are defaults in basemap_config.py.
BASEMAP_ARGENMAP_URL=https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/capabaseargenmap@EPSG%3A3857@png/{z}/{x}/{y}.png
BASEMAP_ARGENMAPGRIS_URL=https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/mapabase_gris@EPSG%3A3857@png/{z}/{x}/{y}.png
BASEMAP_ARGENMAPOSCURO_URL=https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/argenmap_oscuro@EPSG%3A3857@png/{z}/{x}/{y}.png
BASEMAP_ARGENMAPTOPOGRAFICO_URL=https://wms.ign.gob.ar/geoserver/gwc/service/tms/1.0.0/mapabase_topo@EPSG%3A3857@png/{z}/{x}/{y}.png
BASEMAP_SATELLITE_URL=https://server.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
BASEMAP_TOPOGRAPHIC_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Physical_Map/MapServer/tile/{z}/{y}/{x}
BASEMAP_GOOGLESATELLITE_URL=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}
BASEMAP_OCEANBASE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}
