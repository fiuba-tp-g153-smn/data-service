{
  "sync_mode": "full",
  "tile_ttl": 21600,
  "tileset_listing_ttl": 30,
  "sync_interval_seconds": 60,
  "s3_max_concurrent_downloads": 5,
  "cache_control_config": "public, max-age=60, stale-while-revalidate=120",
  "cache_control_tile": "public, max-age=43200, immutable",
  "radar": {
    "tile_ttl": 2592000,
    "sync_interval_seconds": 30
  },
  "ecmwf": {
    "tile_ttl": 86400,
    "forecasts_to_keep": 2,
    "sync_interval_seconds": 120
  },
  "basemap": {
    "sync_mode": "no_cache",
    "tile_ttl": 604800,
    "scrape_interval_seconds": 604800,
    "scrape_concurrent": 20,
    "scrape_delay_ms": 30,
    "scrape_parallelism_mode": "per_origin",
    "scrape_per_host_concurrent": 20,
    "scrape_state_db_path": "data/basemap_scraper_state.sqlite",
    "scrape_checkpoint_every": 200,
    "scrape_checkpoint_seconds": 5.0,
    "cache_max_zoom": 11,
    "cache_concurrent": 10,
    "bbox_lat_min": -60.0,
    "bbox_lat_max": -15.0,
    "bbox_lon_min": -85.0,
    "bbox_lon_max": -40.0,
    "http_timeout_seconds": 10,
    "http_max_retries": 3,
    "reader_http_concurrent": 8,
    "reader_http_timeout_seconds": 3,
    "reader_http_max_retries": 1,
    "request_deadline_seconds": 4.0,
    "s3_object_ttl_days": 14,
    "online_fallback_enabled": true,
    "negative_cache_enabled": true,
    "negative_cache_ttl": 300,
    "cache_control_tile": "public, max-age=604800, immutable",
    "cache_control_tile_miss": "public, max-age=300, immutable",
    "providers": [
      { "id": "argenmap", "enabled": true },
      { "id": "argenmapGris", "enabled": true },
      { "id": "argenmapOscuro", "enabled": true },
      { "id": "argenmapTopografico", "enabled": true },
      { "id": "satellite", "enabled": true },
      { "id": "topographic", "enabled": true },
      { "id": "googleSatellite", "enabled": true },
      { "id": "oceanBase", "enabled": true }
    ]
  }
}
