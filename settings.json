{
  "sync": {
    "mode": "full",
    "interval_seconds": 60,
    "min_sleep_seconds": 20
  },
  "cache_control": {
    "config": "public, max-age=60, stale-while-revalidate=120",
    "tile": "public, max-age=43200, immutable"
  },
  "s3": {
    "sync_max_inflight_tiles": 64
  },
  "tileset_listing_ttl": 30,
  "satellite": {
    "tile_ttl": 21600
  },
  "radar": {
    "tile_ttl": 21600
  },
  "ecmwf": {
    "tile_ttl": 86400,
    "forecasts_to_keep": 2,
    "mslp": {
      "geojson_ttl": 86400
    }
  },
  "wrf": {
    "tile_ttl": 64800,
    "geojson_ttl": 64800,
    "inits_to_keep": 3
  },
  "basemap": {
    "sync_mode": "no_cache",
    "tile_ttl": 86400,
    "cache_control": {
      "tile_miss": "public, max-age=300"
    },
    "scrape": {
      "parallelism_mode": "per_origin"
    },
    "providers": [
      { "id": "argenmap", "enabled": true },
      { "id": "argenmapGris", "enabled": true },
      { "id": "argenmapOscuro", "enabled": true },
      { "id": "argenmapTopografico", "enabled": true },
      { "id": "satellite", "enabled": true },
      { "id": "topographic", "enabled": true },
      { "id": "googleSatellite", "enabled": true },
      { "id": "oceanBase", "enabled": true },

      { "id": "ign-provincia", "enabled": true },
      { "id": "ign-limite-internacional", "enabled": true },
      { "id": "ign-limite-interdepartamental-o-de-partido", "enabled": true },
      { "id": "ign-localidad", "enabled": true },
      { "id": "ign-sublocalidad", "enabled": true },
      { "id": "ign-gobierno-local", "enabled": true }
    ]
  }
}
