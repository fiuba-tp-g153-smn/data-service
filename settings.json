{
  "sync_mode": "full",
  "tile_ttl": 21600,
  "tileset_listing_ttl": 30,
  "sync_interval_seconds": 60,
  "sync_min_sleep_seconds": 20,
  "s3_max_concurrent_downloads": 5,
  "cache_control_config": "public, max-age=60, stale-while-revalidate=120",
  "cache_control_tile": "public, max-age=43200, immutable",
  "radar": {
    "tile_ttl": 2592000
  },
  "ecmwf": {
    "tile_ttl": 86400,
    "forecasts_to_keep": 2
  },
  "ecmwf_mslp": {
    "geojson_ttl": 86400
  },
  "wrf": {
    "tile_ttl": 2592000,
    "geojson_ttl": 2592000,
    "inits_to_keep": 3
  },
  "basemap": {
    "sync_mode": "no_cache",
    "tile_ttl": 2592000,
    "scrape_interval_seconds": 604800,
    "scrape_concurrent": 20,
    "scrape_delay_ms": 30,
    "scrape_parallelism_mode": "per_origin",
    "scrape_per_host_concurrent": 20,
    "scrape_state_db_path": "data/basemap_scraper_state.sqlite",
    "scrape_checkpoint_every": 200,
    "scrape_checkpoint_seconds": 5.0,
    "cache_max_zoom": 11,
    "cache_concurrent": 10,
    "bbox_lat_min": -60.0,
    "bbox_lat_max": -15.0,
    "bbox_lon_min": -85.0,
    "bbox_lon_max": -40.0,
    "http_timeout_seconds": 10,
    "http_max_retries": 3,
    "reader_http_concurrent": 8,
    "reader_http_timeout_seconds": 3,
    "reader_http_max_retries": 1,
    "request_deadline_seconds": 4.0,
    "s3_object_ttl_days": 35,
    "online_fallback_enabled": true,
    "provider_availability_ttl": 240,
    "cache_control_tile": "public, max-age=2592000, immutable",
    "cache_control_tile_miss": "public, max-age=300, immutable",
    "provider_unhealthy_threshold": 5,
    "provider_cooldown_schedule": [300, 900, 3600, 10800, 21600],
    "providers": [
      { "id": "argenmap", "enabled": true },
      { "id": "argenmapGris", "enabled": true },
      { "id": "argenmapOscuro", "enabled": true },
      { "id": "argenmapTopografico", "enabled": true },
      { "id": "satellite", "enabled": true },
      { "id": "topographic", "enabled": true },
      { "id": "googleSatellite", "enabled": true },
      { "id": "oceanBase", "enabled": true },

      { "id": "ign-provincia", "enabled": true },
      { "id": "ign-limite-internacional", "enabled": true },
      { "id": "ign-limite-interdepartamental-o-de-partido", "enabled": true },
      { "id": "ign-localidad", "enabled": true },
      { "id": "ign-sublocalidad", "enabled": true },
      { "id": "ign-gobierno-local", "enabled": true }
    ]
  },
  "weather_stations": {
    "sync_mode": "full",
    "scrape_interval_seconds": 300,
    "scrape_lock_path": "/tmp/weather_stations_scrape.lock",
    "http_timeout_seconds": 30,
    "http_max_retries": 3,
    "token_cache_ttl_seconds": 3600,
    "s3_object_ttl_days": 2,
    "list_cache_ttl_seconds": 30,
    "cache_control_latest": "public, max-age=60, stale-while-revalidate=120",
    "cache_control_tilesets": "public, max-age=60, stale-while-revalidate=120",
    "cache_control_registry": "public, max-age=3600, stale-while-revalidate=86400",
    "cache_control_snapshot": "public, max-age=300",
    "cache_control_series": "public, max-age=300",
    "redis_cache_enabled": true,
    "redis_latest_ttl_seconds": 600,
    "redis_tilesets_ttl_seconds": 600,
    "redis_snapshot_ttl_seconds": 3600,
    "redis_registry_ttl_seconds": 3600,
    "redis_series_ttl_seconds": 3600,
    "redis_animation_warm_buckets": 24,
    "series_hours": 48,
    "api_key_auth_enabled": true,
    "keystore_db_path": "data/weather_stations_keys.sqlite"
